# ===========================================================================
# Copy this file to  .env  (same folder) and fill in your own values.
#
#   Windows PowerShell:   copy .env.example .env
#   Windows CMD:          copy .env.example .env
#
# .env is blocked by .gitignore and must NEVER be committed. This file, with
# no real values in it, is the one that is safe to share - it shows the shape
# without giving anything away.
# ===========================================================================

# --- PostgreSQL -----------------------------------------------------------
# PGPORT: check it. With PostgreSQL 15 AND 18 installed, the second one is
# often on 5433. In pgAdmin: right-click the server -> Properties ->
# Connection -> Port.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=put-your-postgres-password-here
PGDATABASE=tvl_eas

# --- The API --------------------------------------------------------------
PORT=3000

# Minutes of silence before somebody counts as offline.
PRESENCE_WINDOW_MINUTES=8

# Which websites are allowed to call this API from a browser. Comma
# separated, no spaces needed. Do NOT use * - that lets any site on the
# internet read your directory.
ALLOWED_ORIGINS=https://tvl-eas.blogspot.com,http://localhost:3000

# --- Sign-in ---------------------------------------------------------------
# JWT_SECRET signs the tokens that prove who somebody is. Anybody who knows
# it can mint a token saying they are an ADMIN, so it is the most sensitive
# value in this file.
#
# At least 32 characters. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# The server REFUSES TO START without it. That is deliberate: a default
# value here would end up in the public repository and every token in the
# system would be forgeable.
JWT_SECRET=run-the-command-above-and-paste-the-result-here

# How long a sign-in lasts before the person has to sign in again.
# 8h suits a working day. Shorter is safer; much longer is a liability on a
# shared machine.
JWT_TTL=8h

# scrypt cost. Leave it out unless you know why you are changing it.
# Default 65536 (2^16) costs about 200ms and 64MB per sign-in. See the long
# note at the top of api/password.js before raising it.
# SCRYPT_N=65536

# --- Backups ---------------------------------------------------------------
# WHERE THE DUMPS GO, AND THIS IS THE IMPORTANT ONE.
#
# Leave it unset and they land in backups\ inside the repository, which is
# the same disk as the database. That survives a dropped table and nothing
# else - not a dead disk, not a stolen laptop, not a flood. api/backup.js
# prints a warning on every run until this points somewhere else.
#
# Roughly best first:
#
#   BACKUP_DIR=G:\My Drive\TVL-EAS Backups      a synced cloud folder
#   BACKUP_DIR=\\fileserver\eas\db-backups      a company file server
#   BACKUP_DIR=E:\tvl-eas-backups               a second physical disk
#
# No quotes, even if the path has spaces in it. Everything after the = is
# the value.
# BACKUP_DIR=

# WHERE pg_dump IS. The PostgreSQL installer does not put its bin folder on
# PATH, so `pg_dump` at a command prompt says it is not recognised even
# though it is sitting right there. Use the one that came with the server
# being dumped: pg_dump refuses to dump a server newer than itself.
# PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Set this to yes ONLY once the nightly scheduled task actually exists -
# `node backup.js --install` prints how to create it. It is what the Summary
# screen reads to decide between "no backups are scheduled" and "backups are
# scheduled AND THE LAST ONE WAS TWO DAYS AGO", which are very different
# sentences. Claiming one that is not running is the point: then the screen
# complains, every day, until it is fixed.
# BACKUP_SCHEDULED=yes


# ---------------------------------------------------------------------------
# THE LEARNINGS LIBRARY, and the Previous Version shelf
# ---------------------------------------------------------------------------
#
# api/drive.js reads two Drive folders with a Google service account: the
# library the team writes into, and the shelf a replaced document is moved
# onto. With none of this set, the Learnings screen says the library has not
# been connected yet and every other screen is unaffected.
#
# THE KEY FILE IS A PASSWORD. Anybody holding it can do to those two folders
# whatever the service account can. Keep it OUTSIDE this repository -
# .gitignore has a net under the usual names, but that is a net and not a
# plan - and never email it or put it in a ticket.
#
# WHAT LIMITS THE ACCOUNT IS THE SHARING, NOT THE SCOPE. A service account
# has an empty Drive of its own and sees exactly what has been shared with
# it. Share the two folders below and that is its whole world.
# GOOGLE_KEY_FILE=C:\keys\tvl-eas-learnings.json

# The two folder IDs, out of the Drive address bar. For
# https://drive.google.com/drive/folders/1AbC_dEfGhIjK the ID is the last
# part: 1AbC_dEfGhIjK
#
# THE ARCHIVE FOLDER IS A SIBLING OF THE LIBRARY, NOT A CHILD, and that is
# not a preference. The scan takes every file under the root it is given and
# has no skip list, so an archive folder INSIDE the library would put every
# superseded SOP straight back on the shelf it was taken off.
# LEARN_FOLDER_ID=
# LEARN_ARCHIVE_FOLDER_ID=
