# ===========================================================================
# Copy this file to  .env  (same folder) and fill in your own values.
#
#   Windows PowerShell:   copy .env.example .env
#   Windows CMD:          copy .env.example .env
#
# .env is blocked by .gitignore and must NEVER be committed. This file, with
# no real values in it, is the one that is safe to share - it shows the shape
# without giving anything away.
# ===========================================================================

# --- PostgreSQL -----------------------------------------------------------
# PGPORT: check it. With PostgreSQL 15 AND 18 installed, the second one is
# often on 5433. In pgAdmin: right-click the server -> Properties ->
# Connection -> Port.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=put-your-postgres-password-here
PGDATABASE=tvl_eas

# --- The API --------------------------------------------------------------
PORT=3000

# Minutes of silence before somebody counts as offline.
PRESENCE_WINDOW_MINUTES=8

# Which websites are allowed to call this API from a browser. Comma
# separated, no spaces needed. Do NOT use * - that lets any site on the
# internet read your directory.
ALLOWED_ORIGINS=https://tvl-eas.blogspot.com,http://localhost:3000

# --- Sign-in ---------------------------------------------------------------
# JWT_SECRET signs the tokens that prove who somebody is. Anybody who knows
# it can mint a token saying they are an ADMIN, so it is the most sensitive
# value in this file.
#
# At least 32 characters. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# The server REFUSES TO START without it. That is deliberate: a default
# value here would end up in the public repository and every token in the
# system would be forgeable.
JWT_SECRET=run-the-command-above-and-paste-the-result-here

# How long a sign-in lasts before the person has to sign in again.
# 8h suits a working day. Shorter is safer; much longer is a liability on a
# shared machine.
JWT_TTL=8h

# scrypt cost. Leave it out unless you know why you are changing it.
# Default 65536 (2^16) costs about 200ms and 64MB per sign-in. See the long
# note at the top of api/password.js before raising it.
# SCRYPT_N=65536
